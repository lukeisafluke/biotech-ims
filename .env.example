# Flask Application Secret Key (replace with a secure random key in production)
FLASK_SECRET_KEY=dev_secret_key_change_in_production

# Web Portal Authentication Password
APP_PASSWORD=admin

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASS=postgres

# Optional: Custom Backup Directory (Defaults to local_backups/ or detected USB/external drive)
# BACKUP_TARGET=E:\Backups
